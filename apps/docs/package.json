{
  "name": "@m3000/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "prebuild": "pnpm registry:copy",
    "registry:build": "pnpm registry:copy && shadcn build",
    "registry:copy": "tsx scripts/build-registry.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@m3000/market": "workspace:*",
    "@tabler/icons-react": "3.44.0",
    "@vercel/analytics": "2.0.1",
    "fumadocs-core": "16.10.7",
    "fumadocs-mdx": "15.0.13",
    "next": "16.2.11",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tailwindcss/postcss": "4.3.2",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "shadcn": "4.12.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.22.5",
    "typescript": "6.0.3"
  }
